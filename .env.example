NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase transaction-pooler URL for the application.
DATABASE_URL=
# Supabase direct/session URL for trusted migration execution.
DIRECT_DATABASE_URL=
DB_POOL_MAX=1

# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Generate separately from SESSION_SECRET; used by Vercel Cron only.
CRON_SECRET=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_PAYMENT_PROOFS_BUCKET=payment-proofs

INSTAPAY_ENABLED=false
INSTAPAY_ACCOUNT=01039010190
INSTAPAY_QR_URL=

VODAFONE_CASH_ENABLED=false
VODAFONE_CASH_NUMBER=01039010190
VODAFONE_CASH_QR_URL=

# Paymob hosted Unified Checkout. Server only; never expose these as NEXT_PUBLIC_*.
PAYMOB_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated Paymob payment method integration IDs enabled for this merchant.
PAYMOB_INTEGRATION_IDS=
# Optional endpoint overrides. Keep the official HTTPS defaults unless Paymob instructs otherwise.
PAYMOB_API_URL=https://accept.paymob.com/v1/intention/
PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/

EMAIL_ENABLED=false
# Prefer smtp for production. adapter preserves the existing HTTPS email bridge.
EMAIL_PROVIDER=smtp
# Set true only AFTER the provider confirms the sender domain's DNS verification.
EMAIL_DOMAIN_VERIFIED=false
# e.g. SOLÉA Support <a real approved address at your verified domain>
EMAIL_FROM=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Resend sending API key, stored only in the server environment. Never NEXT_PUBLIC_.
SMTP_PASSWORD=
# Legacy adapter only; unused when EMAIL_PROVIDER=smtp.
EMAIL_API_KEY=
EMAIL_ADAPTER_URL=
ADMIN_NOTIFICATION_EMAIL=

# Optional one-time bootstrap; remove after creating the first owner.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set only behind a trusted reverse proxy that overwrites the client-IP header.
TRUST_PROXY=false

# Set true ONLY after independently checking the supplied receiving number in each app.
INSTAPAY_RECIPIENT_VERIFIED=false
VODAFONE_CASH_RECIPIENT_VERIFIED=false
