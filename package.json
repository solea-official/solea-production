{
  "name": "solea-commerce",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:targeted": "node --import tsx --test --test-concurrency=1 tests/vercel-supabase-manual.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:db": "node --import tsx scripts/test-db.ts",
    "test:e2e": "node --import tsx scripts/ui-check.ts",
    "security:scan": "node scripts/scan.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src scripts tests *.ts *.json *.mjs",
    "test:runtime": "node --import tsx scripts/runtime-check.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "typescript": "6.0.3"
  },
  "type": "module"
}
